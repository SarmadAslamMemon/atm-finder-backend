# ==============================================================================
# ATM FINDER BACKEND - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER (Required for Production & Render)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# ------------------------------------------------------------------------------
# 2. DATABASE (Required)
# ------------------------------------------------------------------------------
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_user:your_password@cluster0.xxxxx.mongodb.net/atm_finder?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (Required)
# ------------------------------------------------------------------------------
# Must be at least 16 characters long
JWT_SECRET=super_secret_jwt_key_must_be_at_least_16_characters_long
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. SCRAPER CREDENTIALS & TOKENS (Optional - Only if running live scrapers)
# ------------------------------------------------------------------------------
SCRAPE_ENABLED=false

# Peekaboo SDK Endpoints
PEEKABOO_API_URL=https://secure-sdk.peekaboo.guru/kbprosamdmnioblcruahnhdcjhs_ahajlhljlgjhaskjgl5
PEEKABOO_PUBLIC_BEARER_TOKEN=

# United Bank Limited (UBL)
UBL_PEEKABOO_URL=https://secure-sdk.peekaboo.guru/kbprosamdmnioblcruahnhdcjhs_ahajlhljlgjhaskjgl5
UBL_OWNER_KEY=
UBL_MERCHANT_NAME=United Bank Limited (UBL)

# Bank Alfalah
ALFALAH_OWNER_KEY=
ALFALAH_BEARER_TOKEN=
ALFALAH_MERCHANT_NAME=Bank Alfalah
ALFALAH_DEFAULT_LAT=24.861462
ALFALAH_DEFAULT_LNG=67.009939

# Allied Bank
ALLIED_OWNER_KEY=
ALLIED_BEARER_TOKEN=
ALLIED_MERCHANT_NAME=Allied Bank

# Meezan Bank & Bank AL Habib
MEEZAN_MERCHANT_NAME=Meezan Bank
MEEZAN_ENTITY_ID=45
ALHABIB_MERCHANT_NAME=Bank AL Habib
ALHABIB_ENTITY_ID=46

# HBL
HBL_BRANCH_LOCATOR_URL=https://www.hbl.com/branch-locator/get_locations_by_city
HBL_HEADLESS=true
HBL_COOKIES=
HBL_PAGE_TIMEOUT_MS=120000
HBL_REQUEST_TIMEOUT_MS=60000

# MCB
MCB_BRANCH_LOCATOR_URL=https://www.mcb.com.pk/branch-locator/branch-locator
MCB_HEADLESS=true
MCB_PAGE_TIMEOUT_MS=120000
MCB_REQUEST_TIMEOUT_MS=60000
