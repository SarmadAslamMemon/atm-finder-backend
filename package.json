{
  "name": "atm-finder-backend",
  "version": "1.0.0",
  "description": "Scalable backend and scraping hub for bank ATM/branch locator",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/scripts/seed.ts",
    "scrape:hbl": "tsx src/scrapers/hbl/index.ts",
    "scrape:mcb": "tsx src/scrapers/mcb/index.ts",
    "scrape:ubl": "tsx src/scrapers/ubl/index.ts",
    "scrape:alfalah": "tsx src/scrapers/alfalah/index.ts",
    "scrape:allied": "tsx src/scrapers/allied/index.ts",
    "scrape:meezan": "tsx src/scrapers/meezan/index.ts",
    "scrape:alhabib": "tsx src/scrapers/alhabib/index.ts",
    "scrape:faysal": "tsx src/scrapers/faysal/index.ts",
    "scrape:askari": "tsx src/scrapers/askari/index.ts",
    "scrape:jsbank": "tsx src/scrapers/jsbank/index.ts",
    "scrape:soneri": "tsx src/scrapers/soneri/index.ts",
    "scrape:bop": "tsx src/scrapers/bop/index.ts",
    "scrape:nbp": "tsx src/scrapers/nbp/index.ts",
    "scrape:sindhbank": "tsx src/scrapers/sindhbank/index.ts",
    "scrape:dib": "tsx src/scrapers/dib/index.ts",
    "scrape:bankislami": "tsx src/scrapers/bankislami/index.ts",
    "scrape:albaraka": "tsx src/scrapers/albaraka/index.ts",
    "scrape:habibmetro": "tsx src/scrapers/habibmetro/index.ts",
    "scrape:bok": "tsx src/scrapers/bok/index.ts",
    "scrape:ztbl": "tsx src/scrapers/ztbl/index.ts",
    "scrape:fwbl": "tsx src/scrapers/fwbl/index.ts",
    "scrape:mirpur": "tsx src/scrapers/mirpur/index.ts",
    "scrape:full": "tsx src/scrapers/scrape-full.ts",
    "scrape:all": "tsx src/scrapers/run.ts all",
    "scrape": "tsx src/scrapers/run.ts",
    "tunnel:lt": "npx localtunnel --port 3000",
    "tunnel:ngrok": "npx ngrok http 3000",
    "tunnel:cf": ".tools\\cloudflared.exe tunnel --url http://localhost:3000"
  },
  "keywords": [
    "atm",
    "branch-locator",
    "mongodb",
    "scraping"
  ],
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.5.0",
    "mongoose": "^9.7.4",
    "morgan": "^1.11.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.1.1",
    "playwright": "^1.61.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
